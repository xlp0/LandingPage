---
import path from 'node:path';
import { Layer4TrellisNavigationNet } from 'clm-kernel';
import WorkbenchLayout from '../layouts/WorkbenchLayout.astro';
import TargetToolbarIsland from '../islands/TargetToolbarIsland.jsx';
import DevicePresetsIsland from '../islands/DevicePresetsIsland.jsx';
import ViewportStageIsland from '../islands/ViewportStageIsland.jsx';
import RecordingRibbonIsland from '../islands/RecordingRibbonIsland.jsx';
import ConformancePanelIsland from '../islands/ConformancePanelIsland.jsx';
import MCardResultIsland from '../islands/MCardResultIsland.jsx';
import SpaTestWorkflow from '../islands/SpaTestWorkflow.jsx';
import BombadilDashboardIsland from '../islands/BombadilDashboardIsland.jsx';
import PkcCardIsland from '../islands/PkcCardIsland.jsx';
import PresentationControls from '../components/PresentationControls.astro';
import WorkbenchNav from '../components/WorkbenchNav.astro';
import { iconMarkup } from '../../js/ui/icons.js';
import { loadNetEnvelope, validateNetEnvelope } from '../../scripts/check-net.mjs';
import { createLayer4TargetAdapter } from '../../scripts/net-to-netmcard.mjs';
import { assertDisjointNetIds, serializeTargetNetEnvelope } from '../../js/harness/spa-test-workflow.js';

const workbenchEnvelope = loadNetEnvelope(path.resolve(process.cwd(), 'src/net/workbench-net.yaml'));
const spaTargetEnvelope = loadNetEnvelope(path.resolve(process.cwd(), 'tests/fixtures/spa-test-target.graph.json'));

const workbenchValidation = validateNetEnvelope(workbenchEnvelope, {
  filePath: 'src/net/workbench-net.yaml',
  currentSprint: 'SPRINT-GQC-07'
});
if (!workbenchValidation.valid) {
  throw new Error(`Invalid workbench net: ${workbenchValidation.violations.map((v) => v.message).join('; ')}`);
}

const spaTargetValidation = validateNetEnvelope(spaTargetEnvelope, {
  filePath: 'tests/fixtures/spa-test-target.graph.json',
  currentSprint: 'SPRINT-GQC-07'
});
if (!spaTargetValidation.valid) {
  throw new Error(`Invalid SPA target net: ${spaTargetValidation.violations.map((v) => v.message).join('; ')}`);
}

assertDisjointNetIds(workbenchEnvelope, spaTargetEnvelope);

const layer4Net = new Layer4TrellisNavigationNet();
for (const place of spaTargetEnvelope.topology.places) {
  const binding = spaTargetEnvelope.bindings.places[place.id];
  layer4Net.registerViewPlace(place.id, binding.clmTypeUri, {
    role: binding.entry ? 'Entry' : 'Intermediate'
  });
}
for (const transition of spaTargetEnvelope.topology.transitions) {
  const binding = spaTargetEnvelope.bindings.transitions[transition.id];
  const destBinding = spaTargetEnvelope.bindings.places[binding.toPlaceId];
  if (destBinding?.kind !== 'error' && binding.kind === 'client-route') {
    layer4Net.registerHyperlink(binding.fromPlaceId, binding.linkId, binding.toPlaceId);
  }
}

const validSession = layer4Net.startSession(spaTargetEnvelope.entryPlaceId, 'gqc04-ssr-valid');
const validStep = layer4Net.clickHyperlink(
  validSession.marking,
  'p_spa_overview',
  'link_spa_open_details',
  validSession.sessionToken
);

const trapSession = layer4Net.startSession(spaTargetEnvelope.entryPlaceId, 'gqc04-ssr-trap');
const trapStep = layer4Net.clickHyperlink(
  trapSession.marking,
  'p_spa_overview',
  'link_spa_invalid_unmapped',
  trapSession.sessionToken
);

if (!validStep.navigated || validStep.trappedToErrorModal || validStep.currentViewPlaceId !== 'p_spa_details') {
  throw new Error('Layer 4 validation failed for SPA transition link_spa_open_details');
}
if (trapStep.navigated || !trapStep.trappedToErrorModal) {
  throw new Error('Layer 4 validation failed to trap invalid SPA link link_spa_invalid_unmapped');
}

const spaLayer4Adapter = createLayer4TargetAdapter(spaTargetEnvelope);

const targetNets = {
  '/tests/fixtures/spa-test-target.html': serializeTargetNetEnvelope(spaTargetEnvelope, {
    targetUrl: '/tests/fixtures/spa-test-target.html',
    targetType: 'spa',
    layer4Verification: {
      facade: 'Layer4TrellisNavigationNet',
      netMCardHash: spaLayer4Adapter.netMCardHash,
      bindingsMCardHash: spaLayer4Adapter.bindingsMCardHash,
      committedPlaceId: validStep.currentViewPlaceId,
      invalidLinkTrapped: trapStep.trappedToErrorModal,
      errorModalPlaceId: trapStep.currentViewPlaceId
    }
  })
};
---
<WorkbenchLayout placeIds={['p_page_responsive_lab']} title="GovTech OS - Responsive UI Lab (Full-Window Viewport Workbench)" dataTheme="dark" enablePresentationController={true}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/public/css/semantic-tokens.css">
    <link rel="stylesheet" href="/public/css/responsive-lab.css">
  </Fragment>
  <header class="lab-navbar">
    <div class="lab-nav-left">
      <a href="/index.html?noredirect=1" class="back-home-btn" id="btn-back-home" data-testid="btn-back-home" title="Return to GovTech OS Portal">
        <Fragment set:html={iconMarkup('arrow-left')} />
        <span>GovTech OS</span>
      </a>
      <WorkbenchNav placeId="p_page_responsive_lab" variant="menu" />
      <div class="lab-title-group">
        <h1 id="lab-main-heading">
          <Fragment set:html={iconMarkup('ruler', { size: 16 })} />
          <span>Responsive UI Lab</span>
        </h1>
      </div>
    </div>

    <div class="lab-nav-right">
      <div class="arrangement-toggle-group">
        <span class="arrangement-toggle-label">Arrangement</span>
        <button type="button" id="btn-arrange-horizontal" class="toolbar-btn arrangement-btn active" data-arrangement="horizontal" data-testid="btn-arrange-horizontal" aria-pressed="true" title="Horizontal arrangement (Controls in left sidebar, canvas beside)">
          <Fragment set:html={iconMarkup('columns')} />
          <span>Sidebar</span>
        </button>
        <button type="button" id="btn-arrange-vertical" class="toolbar-btn arrangement-btn" data-arrangement="vertical" data-testid="btn-arrange-vertical" aria-pressed="false" title="Vertical arrangement (Controls stacked at top, canvas below)">
          <Fragment set:html={iconMarkup('rows')} />
          <span>Stacked</span>
        </button>
      </div>

      <PresentationControls buttonClass="toolbar-btn presentation-control-btn" defaultTheme="dark" />

      <button type="button" class="nav-action-link primary" id="mission-control-popout-btn" data-testid="mission-control-popout-btn" data-effect="external" title="Open the current target in a new tab">
        <Fragment set:html={iconMarkup('external-link')} />
        <span>Pop Out Tab</span>
      </button>
    </div>
  </header>

  <div class="lab-workspace-container arrangement-horizontal" id="lab-workspace-container" data-compact-pane="stage">
    <aside class="workbench-controls-dock" id="workbench-controls-dock" data-workbench-mode="explore">
      <div class="workbench-mode-tabs" id="workbench-mode-tabs" role="tablist" aria-label="Workbench modes">
        <button
          type="button"
          role="tab"
          id="btn-mode-stage"
          data-testid="btn-mode-stage"
          data-mode="stage"
          aria-selected="false"
          aria-controls="lab-stage-container"
          tabindex="-1"
          class="workbench-mode-tab workbench-mode-tab--compact-only"
        >
          Stage
        </button>
        <button
          type="button"
          role="tab"
          id="btn-mode-explore"
          data-testid="btn-mode-explore"
          data-mode="explore"
          aria-selected="true"
          aria-controls="device-presets-dock-slot"
          tabindex="0"
          class="workbench-mode-tab active"
        >
          Explore
        </button>
        <button
          type="button"
          role="tab"
          id="btn-mode-guided-spa"
          data-testid="btn-mode-guided-spa"
          data-mode="guided-spa"
          aria-selected="false"
          aria-controls="spa-workflow-dock-slot"
          tabindex="-1"
          class="workbench-mode-tab"
        >
          Guided
        </button>
        <button
          type="button"
          role="tab"
          id="btn-mode-bombadil"
          data-testid="btn-mode-bombadil"
          data-mode="bombadil"
          aria-selected="false"
          aria-controls="bombadil-panel-shell"
          tabindex="-1"
          class="workbench-mode-tab"
        >
          Bombadil
        </button>
        <button
          type="button"
          role="tab"
          id="btn-mode-verify"
          data-testid="btn-mode-verify"
          data-mode="verify"
          aria-selected="false"
          aria-controls="verify-summary-shell"
          tabindex="-1"
          class="workbench-mode-tab"
        >
          Verify
        </button>
      </div>

      <div id="target-toolbar-dock-slot" class="dock-mode-slot">
        <TargetToolbarIsland client:load />
      </div>

      <div id="device-presets-dock-slot" class="dock-mode-slot">
        <DevicePresetsIsland client:load />
      </div>

      <div id="spa-workflow-dock-slot" class="dock-mode-slot" hidden>
        <SpaTestWorkflow client:load targetNets={targetNets} />
      </div>

      <div id="bombadil-panel-shell" data-testid="bombadil-panel-shell" class="dock-mode-slot" hidden>
        <BombadilDashboardIsland client:visible />
      </div>

      <div id="verify-summary-shell" data-testid="verify-summary-shell" class="verify-summary-shell" hidden>
        <div class="group-label">Verification summary</div>
        <div class="mcard-result-row">
          <span class="mcard-result-key">Target</span>
          <code id="verify-summary-target" class="mcard-result-val">/tests/fixtures/spa-test-target.html</code>
        </div>
        <div class="mcard-result-row">
          <span class="mcard-result-key">Preset</span>
          <span id="verify-summary-device" class="mcard-result-val">Full (100%)</span>
        </div>
        <div class="mcard-result-row">
          <span class="mcard-result-key">Bombadil verdict</span>
          <span id="verify-summary-bombadil" class="mcard-result-val" data-status="idle">Bombadil: Idle</span>
        </div>
      </div>

      <div class="toolbar-group" id="conformance-panel-group" hidden>
        <details id="conformance-disclosure" class="lab-disclosure">
          <summary class="lab-disclosure-summary">
            <span class="group-label">Conformance</span>
            <span id="conformance-status-badge" class="footer-status-pill" style="font-size: 0.7rem; color: var(--color-text-muted);">Uncertified</span>
          </summary>
          <ConformancePanelIsland client:visible />
        </details>
      </div>

      <div class="toolbar-group" id="mcard-result-panel-group" hidden>
        <details id="mcard-result-disclosure" class="lab-disclosure">
          <summary class="lab-disclosure-summary">
            <span class="group-label">MCard run result</span>
            <span id="mcard-result-summary-badge" class="footer-status-pill" style="font-size: 0.7rem; color: var(--color-text-muted);">Idle</span>
          </summary>
          <MCardResultIsland client:visible />
        </details>
      </div>

      <div class="toolbar-group" id="pkc-card-panel-group">
        <details id="pkc-card-disclosure" class="lab-disclosure">
          <summary class="lab-disclosure-summary">
            <span class="group-label">PKC Card Interaction</span>
            <span id="pkc-card-summary-badge" class="footer-status-pill" style="font-size: 0.7rem; color: var(--color-text-muted);">Ready</span>
          </summary>
          <PkcCardIsland client:visible />
        </details>
      </div>
    </aside>

    <main class="lab-stage-container" id="lab-stage-container">
      <div class="stage-toolbar" id="stage-toolbar" role="toolbar" aria-label="Viewport stage controls">
        <div class="stage-toolbar-readout">
          <span
            class="frame-target-place-pill"
            id="stage-target-place"
            data-testid="stage-target-place"
            aria-live="polite"
            hidden
          ></span>
          <span class="frame-dimension-pill" id="controlled-frame-dim">
            100% × 100% • Responsive
          </span>
          <p id="stage-message" data-testid="stage-message" role="status"><span id="lab-url-state-notice" data-testid="lab-url-state-notice" hidden></span><span id="stage-refusal-hint" data-testid="stage-refusal-hint" hidden></span></p>
        </div>
        <div class="stage-toolbar-actions">
          <button
            id="btn-rotate-viewport"
            type="button"
            class="toolbar-btn"
            title="Swap Width and Height (90° Rotation)"
            aria-label="Rotate (90°)"
            aria-disabled="true"
            disabled
            data-testid="btn-rotate-viewport"
          >
            <Fragment set:html={iconMarkup('rotate-cw')} />
            <span>Rotate (90°)</span>
          </button>
          <button
            id="btn-scale-toggle"
            type="button"
            class="toolbar-btn"
            title="Toggle between Fit and 1:1 Actual pixel scale"
            aria-pressed="false"
            data-testid="btn-scale-toggle"
          >
            Scale: Fit
          </button>
          <button
            id="btn-safe-area-toggle"
            type="button"
            class="toolbar-btn"
            title="Toggle device safe-area guide overlay"
            aria-pressed="false"
            disabled
            aria-disabled="true"
            data-testid="btn-safe-area-toggle"
          >
            Safe-area: Off
          </button>
          <button
            id="btn-copy-lab-link"
            type="button"
            class="toolbar-btn"
            data-testid="btn-copy-lab-link"
          >
            Copy link
          </button>
        </div>
      </div>

      <div class="stage-well" id="stage-well" data-testid="stage-well">
        <ViewportStageIsland client:only="preact" />
      </div>

      <div class="stage-transport" id="stage-transport" data-testid="stage-transport">
        <div id="lab-recording-bar" class="stage-transport-ribbon">
          <RecordingRibbonIsland client:load />
        </div>
        <button
          type="button"
          id="bombadil-transport-pill"
          class="bombadil-transport-pill"
          data-testid="bombadil-transport-pill"
          data-status="idle"
          aria-live="polite"
          title="Open Bombadil dashboard"
        >
          Bombadil: Idle
        </button>
      </div>
    </main>
  </div>

  <div class="device-manager-backdrop" id="device-manager-modal" role="dialog" aria-modal="true" aria-labelledby="device-manager-title">
    <div class="device-manager-modal">
      <div class="dm-header">
        <h2 id="device-manager-title"><Fragment set:html={iconMarkup('settings', { size: 16 })} /> Device Preset Manager</h2>
        <button type="button" id="btn-close-modal" class="toolbar-btn" data-testid="btn-close-modal" aria-label="Close Device Preset Manager">
          <Fragment set:html={iconMarkup('x')} />
        </button>
      </div>

      <p class="dm-hint">Manage standard and custom screen sizes for responsive viewport testing.</p>

      <form class="dm-form" id="device-form" autocomplete="off" novalidate>
        <label class="dm-field" for="input-device-name">Name
          <input id="input-device-name" data-testid="input-device-name" type="text" maxlength="40" placeholder="iPhone 16 Pro Max" />
        </label>
        <label class="dm-field" for="select-device-category">Category
          <select id="select-device-category" data-testid="select-device-category">
            <option value="phone">Phone</option>
            <option value="tablet">Tablet</option>
            <option value="desktop">Desktop</option>
            <option value="wearable">Wearable</option>
            <option value="custom">Custom</option>
          </select>
        </label>
        <label class="dm-field" for="input-device-width">Width (px)
          <input id="input-device-width" data-testid="input-device-width" type="number" placeholder="440" />
        </label>
        <label class="dm-field" for="input-device-height">Height (px)
          <input id="input-device-height" data-testid="input-device-height" type="number" placeholder="956" />
        </label>
        <label class="dm-field" for="select-device-frame-style">Frame Style
          <select id="select-device-frame-style" data-testid="select-device-frame-style">
            <option value="">Auto (category)</option>
            <option value="phone-ios">Phone iOS</option>
            <option value="phone-android">Phone Android</option>
            <option value="tablet">Tablet</option>
            <option value="browser-window">Browser Window</option>
            <option value="hairline-ruler">Hairline Ruler</option>
            <option value="unframed">Unframed</option>
          </select>
        </label>
        <button id="btn-save-device" data-testid="btn-save-device" type="submit" class="toolbar-btn">Add Device Preset</button>
      </form>

      <div class="dm-error" id="device-form-error" role="alert" aria-live="polite"></div>

      <div class="dm-list" id="device-manager-list" role="list"></div>

      <div class="dm-actions">
        <button id="btn-reset-devices" class="toolbar-btn" type="button" data-testid="btn-reset-devices" data-effect="destructive">
          <Fragment set:html={iconMarkup('rotate-ccw')} /> Reset All to Defaults
        </button>
        <button id="btn-close-modal-footer" class="toolbar-btn" type="button" data-testid="btn-close-modal-footer">Close</button>
      </div>
    </div>
  </div>

  <footer class="lab-footer">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span id="controlled-panel-status">Viewport: Full (100%) • Responsive • [Side-by-Side Dock]</span>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span>GovTech OS • Responsive Layout Lab</span>
    </div>
  </footer>
</WorkbenchLayout>
