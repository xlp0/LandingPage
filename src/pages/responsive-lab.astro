  <div class="device-manager-backdrop" id="device-manager-modal" role="dialog" aria-modal="true" aria-labelledby="device-manager-title">
    <div class="device-manager-modal">
      <div class="dm-header">
        <h2 id="device-manager-title">⚙️ Device Preset Manager</h2>
        <button id="btn-close-modal" class="toolbar-btn" aria-label="Close Device Preset Manager">✕</button>
      </div>

      <p class="dm-hint">Manage standard and custom screen sizes for responsive viewport testing.</p>

      <form class="dm-form" id="device-form" autocomplete="off" novalidate>
        <label class="dm-field" for="input-device-name">Name
          <input id="input-device-name" type="text" maxlength="40" placeholder="iPhone 16 Pro Max" />
        </label>
        <label class="dm-field" for="select-device-category">Category
          <select id="select-device-category">
            <option value="phone">Phone</option>
            <option value="tablet">Tablet</option>
            <option value="desktop">Desktop</option>
            <option value="wearable">Wearable</option>
            <option value="custom">Custom</option>
          </select>
        </label>
        <label class="dm-field" for="input-device-width">Width (px)
          <input id="input-device-width" type="number" placeholder="440" />
        </label>
        <label class="dm-field" for="input-device-height">Height (px)
          <input id="input-device-height" type="number" placeholder="956" />
        </label>
        <button id="btn-save-device" type="submit" class="toolbar-btn">Add Device Preset</button>
      </form>

      <div class="dm-error" id="device-form-error" role="alert" aria-live="polite"></div>

      <div class="dm-list" id="device-manager-list" role="list"></div>

      <div class="dm-actions">
        <button id="btn-reset-devices" class="toolbar-btn" type="button">↺ Reset All to Defaults</button>
        <button id="btn-close-modal-footer" class="toolbar-btn" type="button">Close</button>
      </div>
    </div>
  </div>

  <footer class="lab-footer">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span id="controlled-panel-status">● Viewport: Full (100%) • ↔ Horizontal (Landscape) • [☲ Side-by-Side Arrangement]</span>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span>GovTech OS • Responsive Layout Lab</span>
      <span style="color: var(--color-text-muted);">|</span>
      <span>INV-CDO-20 &amp; INV-CDO-21 Certified</span>
    </div>
  </footer>
