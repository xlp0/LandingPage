---
import path from 'node:path';
import { Layer4TrellisNavigationNet } from 'clm-kernel';
import WorkbenchLayout from '../layouts/WorkbenchLayout.astro';
import TargetToolbarIsland from '../islands/TargetToolbarIsland.jsx';
import DevicePresetsIsland from '../islands/DevicePresetsIsland.jsx';
import ViewportStageIsland from '../islands/ViewportStageIsland.jsx';
import RecordingRibbonIsland from '../islands/RecordingRibbonIsland.jsx';
import ConformancePanelIsland from '../islands/ConformancePanelIsland.jsx';
import MCardResultIsland from '../islands/MCardResultIsland.jsx';
import SpaTestWorkflow from '../islands/SpaTestWorkflow.jsx';
import { loadNetEnvelope, validateNetEnvelope } from '../../scripts/check-net.mjs';
import { createLayer4TargetAdapter } from '../../scripts/net-to-netmcard.mjs';
import { assertDisjointNetIds, serializeTargetNetEnvelope } from '../../js/harness/spa-test-workflow.js';

const workbenchEnvelope = loadNetEnvelope(path.resolve(process.cwd(), 'src/net/workbench-net.yaml'));
const spaTargetEnvelope = loadNetEnvelope(path.resolve(process.cwd(), 'tests/fixtures/spa-test-target.graph.json'));

const workbenchValidation = validateNetEnvelope(workbenchEnvelope, {
  filePath: 'src/net/workbench-net.yaml',
  currentSprint: 'SPRINT-GQC-07'
});
if (!workbenchValidation.valid) {
  throw new Error(`Invalid workbench net: ${workbenchValidation.violations.map((v) => v.message).join('; ')}`);
}

const spaTargetValidation = validateNetEnvelope(spaTargetEnvelope, {
  filePath: 'tests/fixtures/spa-test-target.graph.json',
  currentSprint: 'SPRINT-GQC-07'
});
if (!spaTargetValidation.valid) {
  throw new Error(`Invalid SPA target net: ${spaTargetValidation.violations.map((v) => v.message).join('; ')}`);
}

assertDisjointNetIds(workbenchEnvelope, spaTargetEnvelope);

const layer4Net = new Layer4TrellisNavigationNet();
for (const place of spaTargetEnvelope.topology.places) {
  const binding = spaTargetEnvelope.bindings.places[place.id];
  layer4Net.registerViewPlace(place.id, binding.clmTypeUri, {
    role: binding.entry ? 'Entry' : 'Intermediate'
  });
}
for (const transition of spaTargetEnvelope.topology.transitions) {
  const binding = spaTargetEnvelope.bindings.transitions[transition.id];
  const destBinding = spaTargetEnvelope.bindings.places[binding.toPlaceId];
  if (destBinding?.kind !== 'error' && binding.kind === 'client-route') {
    layer4Net.registerHyperlink(binding.fromPlaceId, binding.linkId, binding.toPlaceId);
  }
}

const validSession = layer4Net.startSession(spaTargetEnvelope.entryPlaceId, 'gqc04-ssr-valid');
const validStep = layer4Net.clickHyperlink(
  validSession.marking,
  'p_spa_overview',
  'link_spa_open_details',
  validSession.sessionToken
);

const trapSession = layer4Net.startSession(spaTargetEnvelope.entryPlaceId, 'gqc04-ssr-trap');
const trapStep = layer4Net.clickHyperlink(
  trapSession.marking,
  'p_spa_overview',
  'link_spa_invalid_unmapped',
  trapSession.sessionToken
);

if (!validStep.navigated || validStep.trappedToErrorModal || validStep.currentViewPlaceId !== 'p_spa_details') {
  throw new Error('Layer 4 validation failed for SPA transition link_spa_open_details');
}
if (trapStep.navigated || !trapStep.trappedToErrorModal) {
  throw new Error('Layer 4 validation failed to trap invalid SPA link link_spa_invalid_unmapped');
}

const spaLayer4Adapter = createLayer4TargetAdapter(spaTargetEnvelope);

const targetNets = {
  '/tests/fixtures/spa-test-target.html': serializeTargetNetEnvelope(spaTargetEnvelope, {
    targetUrl: '/tests/fixtures/spa-test-target.html',
    targetType: 'spa',
    layer4Verification: {
      facade: 'Layer4TrellisNavigationNet',
      netMCardHash: spaLayer4Adapter.netMCardHash,
      bindingsMCardHash: spaLayer4Adapter.bindingsMCardHash,
      committedPlaceId: validStep.currentViewPlaceId,
      invalidLinkTrapped: trapStep.trappedToErrorModal,
      errorModalPlaceId: trapStep.currentViewPlaceId
    }
  })
};
---
<WorkbenchLayout placeIds={['p_page_responsive_lab']} title="GovTech OS - Responsive UI Lab (Full-Window Viewport Workbench)" dataTheme="dark">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/semantic-tokens.css">

  <link rel="stylesheet" href="/public/css/responsive-lab.css">
  </Fragment>
  <header class="lab-navbar">
    <div class="lab-nav-left">
      <a href="/index.html?noredirect=1" class="back-home-btn" id="btn-back-home" data-testid="btn-back-home" title="Return to GovTech OS Portal">
        <span>← GovTech OS</span>
      </a>
      <div class="lab-title-group">
        <h1 id="lab-main-heading">
          <span>📐 Responsive UI Lab</span>
        </h1>
      </div>
    </div>

    <div class="lab-nav-right">
      <div class="arrangement-toggle-group" style="display: flex; gap: 0.25rem; background: var(--color-scrim); padding: 0.2rem; border-radius: 8px; border: 1px solid var(--color-border);">
        <span style="font-size: 0.72rem; color: var(--color-text-muted); align-self: center; margin: 0 0.35rem; font-weight: 500;">Arrangement:</span>
        <button id="btn-arrange-horizontal" class="toolbar-btn arrangement-btn active" data-arrangement="horizontal" data-testid="btn-arrange-horizontal" aria-pressed="true" title="Horizontal arrangement (Controls in left sidebar, canvas beside)">
          <span>☲ Sidebar</span>
        </button>
        <button id="btn-arrange-vertical" class="toolbar-btn arrangement-btn" data-arrangement="vertical" data-testid="btn-arrange-vertical" aria-pressed="false" title="Vertical arrangement (Controls stacked at top, canvas below)">
          <span>☰ Stacked</span>
        </button>
      </div>

      <a href="app.html" target="_blank" class="nav-action-link secondary" id="btn-nav-mission-control" data-testid="btn-nav-mission-control" data-effect="navigate" title="Open Mission Control Observability Cockpit">
        <span>🎛️ Mission Control</span>
      </a>
      <button type="button" class="nav-action-link primary" id="mission-control-popout-btn" data-testid="mission-control-popout-btn" data-effect="external" title="Open the current target in a new tab">
        <span>⧉ Pop Out Tab</span>
      </button>
    </div>
  </header>

  <div class="lab-recording-strip" id="lab-recording-strip" style="background: var(--panel-deep-strong); border-bottom: 1px solid var(--border-subtle); padding: 0.5rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; z-index: 50;">
    <div id="lab-recording-bar" style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <RecordingRibbonIsland client:load />
    </div>
  </div>

  <div class="lab-workspace-container arrangement-horizontal" id="lab-workspace-container">
    <aside class="workbench-controls-dock" id="workbench-controls-dock">
      <DevicePresetsIsland client:load />

      <TargetToolbarIsland client:load />

      <SpaTestWorkflow client:load targetNets={targetNets} />

      <div class="toolbar-group" id="conformance-panel-group">
        <details id="conformance-disclosure" class="lab-disclosure">
          <summary class="lab-disclosure-summary">
            <span class="group-label">Conformance:</span>
            <span id="conformance-status-badge" class="footer-status-pill" style="font-size: 0.7rem; color: var(--color-text-muted);">Standby</span>
          </summary>
          <ConformancePanelIsland client:visible />
        </details>
      </div>

      <div class="toolbar-group" id="mcard-result-panel-group">
        <details id="mcard-result-disclosure" class="lab-disclosure">
          <summary class="lab-disclosure-summary">
            <span class="group-label">MCard Run Result:</span>
            <span id="mcard-result-summary-badge" class="footer-status-pill" style="font-size: 0.7rem; color: var(--color-text-muted);">Idle</span>
          </summary>
          <MCardResultIsland client:visible />
        </details>
      </div>
    </aside>

    <main class="lab-stage-container" id="lab-stage-container">
      <ViewportStageIsland client:only="preact" />
    </main>
  </div>

  <div class="device-manager-backdrop" id="device-manager-modal" role="dialog" aria-modal="true" aria-labelledby="device-manager-title">
    <div class="device-manager-modal">
      <div class="dm-header">
        <h2 id="device-manager-title">⚙️ Device Preset Manager</h2>
        <button id="btn-close-modal" class="toolbar-btn" data-testid="btn-close-modal" aria-label="Close Device Preset Manager">✕</button>
      </div>

      <p class="dm-hint">Manage standard and custom screen sizes for responsive viewport testing.</p>

      <form class="dm-form" id="device-form" autocomplete="off" novalidate>
        <label class="dm-field" for="input-device-name">Name
          <input id="input-device-name" data-testid="input-device-name" type="text" maxlength="40" placeholder="iPhone 16 Pro Max" />
        </label>
        <label class="dm-field" for="select-device-category">Category
          <select id="select-device-category" data-testid="select-device-category">
            <option value="phone">Phone</option>
            <option value="tablet">Tablet</option>
            <option value="desktop">Desktop</option>
            <option value="wearable">Wearable</option>
            <option value="custom">Custom</option>
          </select>
        </label>
        <label class="dm-field" for="input-device-width">Width (px)
          <input id="input-device-width" data-testid="input-device-width" type="number" placeholder="440" />
        </label>
        <label class="dm-field" for="input-device-height">Height (px)
          <input id="input-device-height" data-testid="input-device-height" type="number" placeholder="956" />
        </label>
        <button id="btn-save-device" data-testid="btn-save-device" type="submit" class="toolbar-btn">Add Device Preset</button>
      </form>

      <div class="dm-error" id="device-form-error" role="alert" aria-live="polite"></div>

      <div class="dm-list" id="device-manager-list" role="list"></div>

      <div class="dm-actions">
        <button id="btn-reset-devices" class="toolbar-btn" type="button" data-testid="btn-reset-devices" data-effect="destructive">↺ Reset All to Defaults</button>
        <button id="btn-close-modal-footer" class="toolbar-btn" type="button" data-testid="btn-close-modal-footer">Close</button>
      </div>
    </div>
  </div>

  <footer class="lab-footer">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span id="controlled-panel-status">● Viewport: Full (100%) • ↔ Horizontal (Landscape) • [☲ Side-by-Side Arrangement]</span>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <span>GovTech OS • Responsive Layout Lab</span>
    </div>
  </footer>
</WorkbenchLayout>
