  <header class="lab-navbar">
    <div class="lab-nav-left">
      <a href="/" class="back-home-btn" id="btn-back-home" title="Return to GovTech OS Portal">
        <span>← GovTech OS</span>
      </a>
      <div class="lab-title-group">
        <h1 id="lab-main-heading">
          <span>📐 Responsive UI Lab</span>
        </h1>
        <span class="lab-badge">Sprint CDO-12 • Full-Window Workbench</span>
      </div>
    </div>

    <div class="lab-nav-right">
      <div class="arrangement-toggle-group" style="display: flex; gap: 0.25rem; background: var(--color-scrim); padding: 0.2rem; border-radius: 8px; border: 1px solid var(--color-border);">
        <span style="font-size: 0.72rem; color: var(--color-text-muted); align-self: center; margin: 0 0.35rem; font-weight: 500;">Arrangement:</span>
        <button id="btn-arrange-horizontal" class="toolbar-btn arrangement-btn active" data-arrangement="horizontal" title="Horizontal arrangement (Controls in left sidebar, canvas beside)">
          <span>☲ Horizontal</span>
        </button>
        <button id="btn-arrange-vertical" class="toolbar-btn arrangement-btn" data-arrangement="vertical" title="Vertical arrangement (Controls stacked at top, canvas below)">
          <span>☰ Vertical</span>
        </button>
      </div>

      <a href="app.html" target="_blank" class="nav-action-link secondary" id="btn-nav-mission-control" title="Open Mission Control Observability Cockpit">
        <span>🎛️ Mission Control</span>
      </a>
      <a href="app.html" target="_blank" class="nav-action-link primary" id="mission-control-popout-btn" title="Open Target in External Tab">
        <span>⧉ Pop Out Tab</span>
      </a>
    </div>
  </header>

  <aside class="real-estate-banner" id="cors-notice-banner">
    <div>
      <span class="real-estate-tag">🖥️ Full-Window Real-Estate</span>
      <strong style="color: var(--color-text-primary); margin-left: 0.35rem;">Sprint CDO-12: Full-Window Workbench (Horizontal &amp; Vertical Arrangements)</strong>
      <span style="margin-left: 0.5rem;">Cramped sliding panels have been eliminated. Supports both Side-by-Side (Horizontal) and Stacked (Vertical) arrangements for testing live layout reflow across Vertical (Portrait) and Horizontal (Landscape) orientations.</span>
    </div>
    <div style="font-size: 0.72rem; opacity: 0.8;">
      Desktop App (Tauri) Multi-Webview Architecture Reserved for Native Packaging
    </div>
  </aside>

  <div class="lab-recording-strip" id="lab-recording-strip" style="background: var(--panel-deep-strong); border-bottom: 1px solid var(--border-subtle); padding: 0.5rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; z-index: 50;">
    <div id="lab-recording-bar" style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <RecordingRibbonIsland client:load />
    </div>
  </div>

  <div class="lab-workspace-container arrangement-horizontal" id="lab-workspace-container">
    <aside class="workbench-controls-dock" id="workbench-controls-dock">
      <DevicePresetsIsland client:load />

      <TargetToolbarIsland client:load />

      <SpaTestWorkflow client:load targetNets={targetNets} />

      <div class="toolbar-group" id="conformance-panel-group">
        <details id="conformance-disclosure" class="lab-disclosure">
          <summary class="lab-disclosure-summary">
            <span class="group-label">Conformance:</span>
            <span id="conformance-status-badge" class="footer-status-pill" style="font-size: 0.7rem; color: var(--color-text-muted);">Standby</span>
          </summary>
          <ConformancePanelIsland client:visible />
        </details>
      </div>

      <div class="toolbar-group" id="mcard-result-panel-group">
        <details id="mcard-result-disclosure" class="lab-disclosure">
          <summary class="lab-disclosure-summary">
            <span class="group-label">MCard Run Result:</span>
            <span id="mcard-result-summary-badge" class="footer-status-pill" style="font-size: 0.7rem; color: var(--color-text-muted);">Idle</span>
          </summary>
          <MCardResultIsland client:visible />
        </details>
      </div>
