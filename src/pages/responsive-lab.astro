---
import path from 'node:path';
import { Layer4TrellisNavigationNet } from 'clm-kernel';
import WorkbenchLayout from '../layouts/WorkbenchLayout.astro';
import TargetToolbarIsland from '../islands/TargetToolbarIsland.jsx';
import DevicePresetsIsland from '../islands/DevicePresetsIsland.jsx';
import ViewportStageIsland from '../islands/ViewportStageIsland.jsx';
import RecordingRibbonIsland from '../islands/RecordingRibbonIsland.jsx';
import ConformancePanelIsland from '../islands/ConformancePanelIsland.jsx';
import MCardResultIsland from '../islands/MCardResultIsland.jsx';
import SpaTestWorkflow from '../islands/SpaTestWorkflow.jsx';
import { loadNetEnvelope, validateNetEnvelope } from '../../scripts/check-net.mjs';
import { assertDisjointNetIds, serializeTargetNetEnvelope } from '../../js/harness/spa-test-workflow.js';

const workbenchEnvelope = loadNetEnvelope(path.resolve(process.cwd(), 'src/net/workbench-net.yaml'));
const spaTargetEnvelope = loadNetEnvelope(path.resolve(process.cwd(), 'tests/fixtures/spa-test-target.graph.json'));

const workbenchValidation = validateNetEnvelope(workbenchEnvelope, {
  filePath: 'src/net/workbench-net.yaml',
  currentSprint: 'SPRINT-GQC-04'
});
if (!workbenchValidation.valid) {
  throw new Error(`Invalid workbench net: ${workbenchValidation.violations.map((v) => v.message).join('; ')}`);
}

const spaTargetValidation = validateNetEnvelope(spaTargetEnvelope, {
  filePath: 'tests/fixtures/spa-test-target.graph.json',
  currentSprint: 'SPRINT-GQC-04'
});
if (!spaTargetValidation.valid) {
  throw new Error(`Invalid SPA target net: ${spaTargetValidation.violations.map((v) => v.message).join('; ')}`);
}

assertDisjointNetIds(workbenchEnvelope, spaTargetEnvelope);

const layer4Net = new Layer4TrellisNavigationNet();
for (const place of spaTargetEnvelope.topology.places) {
  const binding = spaTargetEnvelope.bindings.places[place.id];
  layer4Net.registerViewPlace(place.id, binding.clmTypeUri, {
    role: binding.entry ? 'Entry' : 'Intermediate'
  });
}
for (const transition of spaTargetEnvelope.topology.transitions) {
  const binding = spaTargetEnvelope.bindings.transitions[transition.id];
  const destBinding = spaTargetEnvelope.bindings.places[binding.toPlaceId];
  if (destBinding?.kind !== 'error' && binding.kind === 'client-route') {
    layer4Net.registerHyperlink(binding.fromPlaceId, binding.linkId, binding.toPlaceId);
  }
}

const validSession = layer4Net.startSession(spaTargetEnvelope.entryPlaceId, 'gqc04-ssr-valid');
const validStep = layer4Net.clickHyperlink(
  validSession.marking,
  'p_spa_overview',
  'link_spa_open_details',
  validSession.sessionToken
);

const trapSession = layer4Net.startSession(spaTargetEnvelope.entryPlaceId, 'gqc04-ssr-trap');
const trapStep = layer4Net.clickHyperlink(
  trapSession.marking,
  'p_spa_overview',
  'link_spa_invalid_unmapped',
  trapSession.sessionToken
);

if (!validStep.navigated || validStep.trappedToErrorModal || validStep.currentViewPlaceId !== 'p_spa_details') {
  throw new Error('Layer 4 validation failed for SPA transition link_spa_open_details');
}
if (trapStep.navigated || !trapStep.trappedToErrorModal) {
  throw new Error('Layer 4 validation failed to trap invalid SPA link link_spa_invalid_unmapped');
}

const targetNets = {
  '/tests/fixtures/spa-test-target.html': serializeTargetNetEnvelope(spaTargetEnvelope, {
    targetUrl: '/tests/fixtures/spa-test-target.html',
    targetType: 'spa',
    layer4Verification: {
      facade: 'Layer4TrellisNavigationNet',
      committedPlaceId: validStep.currentViewPlaceId,
      invalidLinkTrapped: trapStep.trappedToErrorModal,
      errorModalPlaceId: trapStep.currentViewPlaceId
    }
  })
};
---
<WorkbenchLayout title="GovTech OS - Responsive UI Lab (Full-Window Viewport Workbench)" dataTheme="dark" bodyClass="lab-booting">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/semantic-tokens.css">

  <style is:inline>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--color-bg);
      color: var(--color-text-primary);
      
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    
    .lab-navbar {
      height: 60px;
      background: var(--color-surface);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      z-index: 50;
      flex-shrink: 0;
    }

    .lab-nav-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .back-home-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.85rem;
      border-radius: 8px;
      background: var(--overlay-subtle);
      border: 1px solid var(--border-strong);
      color: var(--color-text-primary);
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .back-home-btn:hover {
      background: var(--overlay-soft);
      border-color: var(--color-primary);
      color: var(--badge-info-text);
    }

    .lab-title-group {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .lab-title-group h1 {
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--color-text-primary);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .lab-badge {
      font-size: 0.68rem;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      background: var(--badge-info-bg);
      color: var(--badge-info-text);
      border: 1px solid var(--badge-info-border);
      font-weight: 600;
    }

    .lab-nav-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .nav-action-link {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.8rem;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .nav-action-link.secondary {
      background: var(--overlay-subtle);
      border: 1px solid var(--color-border);
      color: var(--panel-text);
    }

    .nav-action-link.secondary:hover {
      background: var(--overlay-soft);
      color: var(--color-text-primary);
    }

    .nav-action-link.primary {
      
      background: linear-gradient(135deg, var(--color-primary-hover), var(--color-primary-hover));
      border: 1px solid var(--color-primary);
      color: var(--color-on-primary);
    }

    .nav-action-link.primary:hover {
      background: linear-gradient(135deg, var(--color-primary-hover), var(--color-primary-hover));
      box-shadow: 0 0 12px var(--badge-info-border);
    }

    
    .real-estate-banner {
      background: linear-gradient(90deg, var(--panel-strong), var(--panel-deep-strong));
      border-bottom: 1px solid var(--border-subtle);
      padding: 0.45rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.78rem;
      color: var(--color-text-secondary);
      flex-shrink: 0;
    }

    .real-estate-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--color-success-surface);
      border: 1px solid var(--badge-success-border);
      color: var(--badge-success-text);
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      font-weight: 600;
      font-size: 0.72rem;
    }

    
    .workbench-toolbar {
      background: var(--panel-deep-strong);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0.75rem 1.5rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-shrink: 0;
      z-index: 40;
    }

    .toolbar-group {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
    }

    .group-label {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    
    .toolbar-btn {
      background: var(--panel);
      border: 1px solid var(--border-strong);
      color: var(--color-text-secondary);
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.15s ease;
      user-select: none;
    }

    .toolbar-btn:hover {
      background: var(--badge-info-bg);
      color: var(--color-text-primary);
      border-color: var(--color-primary);
    }

    .toolbar-btn.active {
      background: var(--badge-success-bg);
      border-color: var(--color-success);
      color: var(--badge-success-text);
      font-weight: 600;
      box-shadow: 0 0 10px var(--badge-success-bg);
    }

    .orientation-btn-primary.active {
      background: var(--badge-info-bg-strong);
      border-color: var(--color-primary);
      color: var(--badge-info-text);
      box-shadow: 0 0 10px var(--badge-info-bg-strong);
    }

    
    .custom-dim-form {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--scrim-soft);
      padding: 0.2rem 0.5rem;
      border-radius: 6px;
      border: 1px solid var(--color-border);
    }

    .dim-input {
      width: 58px;
      background: var(--panel-deep);
      border: 1px solid var(--border-strong);
      color: var(--color-text-primary);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      padding: 0.2rem 0.35rem;
      border-radius: 4px;
      text-align: center;
    }

    
    .url-selector-strip {
      background: var(--panel-deep-strong);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0.65rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .target-omnibar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }

    .target-url-input-wrap {
      display: flex;
      align-items: center;
      position: relative;
      width: 100%;
      background: var(--panel);
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      padding: 0.2rem 0.25rem 0.2rem 0.65rem;
      transition: all 0.2s ease;
      gap: 0.4rem;
    }

    .target-url-input-wrap:focus-within {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
      background: var(--color-surface);
    }

    .target-url-icon {
      font-size: 0.85rem;
      opacity: 0.65;
      user-select: none;
      flex-shrink: 0;
    }

    .target-url-input {
      flex: 1;
      min-width: 0;
      background: transparent;
      border: none;
      outline: none;
      color: var(--color-text-primary);
      font-family: 'JetBrains Mono', 'Inter', monospace;
      font-size: 0.8rem;
      padding: 0.3rem 0;
    }

    .target-url-input::placeholder {
      color: var(--color-text-muted);
      opacity: 0.7;
      font-family: 'Inter', sans-serif;
    }

    .url-clear-btn {
      background: transparent;
      border: none;
      color: var(--color-text-muted);
      cursor: pointer;
      font-size: 0.75rem;
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      display: none;
      align-items: center;
      justify-content: center;
      transition: all 0.15s ease;
      flex-shrink: 0;
    }

    .url-clear-btn:hover {
      background: var(--overlay-soft);
      color: var(--color-text-primary);
    }

    .load-target-btn {
      background: var(--color-primary);
      color: #ffffff;
      border: 1px solid var(--color-primary);
      font-weight: 600;
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.76rem;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.15s ease;
      flex-shrink: 0;
      white-space: nowrap;
    }

    .load-target-btn:hover {
      background: var(--color-primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 2px 6px rgba(59, 130, 246, 0.3);
    }

    .load-target-btn:active {
      transform: translateY(0);
    }

    .target-presets-row {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      width: 100%;
    }

    .preset-dropdown-wrap {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      width: 100%;
    }

    .target-url-select {
      flex: 1;
      width: 100%;
      background: var(--panel);
      border: 1px solid var(--border-strong);
      color: var(--color-text-primary);
      font-size: 0.76rem;
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      outline: none;
      cursor: pointer;
      transition: border-color 0.15s ease;
    }

    .target-url-select:focus {
      border-color: var(--color-primary);
    }

    .target-quick-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
      width: 100%;
    }

    .target-chip {
      background: var(--overlay-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: 9999px;
      padding: 0.18rem 0.55rem;
      font-size: 0.68rem;
      color: var(--color-text-muted);
      cursor: pointer;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 500;
      transition: all 0.15s ease;
      white-space: nowrap;
      user-select: none;
    }

    .target-chip:hover {
      background: var(--overlay-soft);
      border-color: var(--color-primary);
      color: var(--color-text-primary);
      transform: translateY(-1px);
    }

    .target-chip.active {
      background: rgba(59, 130, 246, 0.15);
      border-color: var(--color-primary);
      color: var(--badge-info-text);
      font-weight: 600;
    }

    .target-status-row {
      width: 100%;
    }

    
    .lab-workspace-container {
      flex: 1;
      min-height: 0;
      display: flex;
      overflow: hidden;
      position: relative;
      width: 100%;
      height: calc(100vh - 60px - 34px - 38px);
    }

    
    .lab-workspace-container.arrangement-vertical {
      flex-direction: column;
    }

    .lab-workspace-container.arrangement-vertical .workbench-controls-dock {
      width: 100%;
      max-height: 44vh;
      overflow-y: auto;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
    }

    .lab-workspace-container.arrangement-vertical .lab-stage-container {
      flex: 1;
      min-height: 0;
      width: 100%;
      align-self: stretch;
      padding: 1.25rem 1.5rem;
    }

    
    .lab-workspace-container.arrangement-horizontal {
      flex-direction: row;
    }

    .lab-workspace-container.arrangement-horizontal .workbench-controls-dock {
      width: 330px;
      flex-shrink: 0;
      height: 100%;
      border-right: 1px solid var(--color-border);
      background: var(--color-surface);
      backdrop-filter: blur(12px);
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      padding: 1.25rem 1rem;
      gap: 1.25rem;
    }

    .lab-workspace-container.arrangement-horizontal .workbench-toolbar {
      flex-direction: column;
      align-items: stretch;
      background: transparent;
      border-bottom: none;
      padding: 0;
      gap: 1rem;
    }

    .lab-workspace-container.arrangement-horizontal .toolbar-group {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }

    .lab-workspace-container.arrangement-horizontal .toolbar-group-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .lab-workspace-container.arrangement-horizontal .url-selector-strip {
      flex-direction: column;
      align-items: stretch;
      background: transparent;
      border-bottom: none;
      padding: 0;
      gap: 0.5rem;
    }

    .lab-workspace-container.arrangement-horizontal .target-url-select {
      max-width: 100%;
      width: 100%;
    }

    .lab-workspace-container.arrangement-horizontal .lab-stage-container {
      flex: 1;
      min-height: 0;
      min-width: 0;
      align-self: stretch;
      padding: 1.5rem;
    }

    
    .lab-stage-container {
      flex: 1;
      min-height: 0;
      align-self: stretch;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      background: radial-gradient(circle at center, var(--panel-soft) 0%, var(--panel-deep-strong) 100%);
      overflow: hidden;
      position: relative;
    }

    
    .viewport-frame {
      flex: none;
      width: var(--frame-target-width, 100%);
      height: var(--frame-target-height, 100%);
      
      background: var(--panel-abyss);
      border: 1px solid var(--border-strong);
      border-radius: 12px;
      box-shadow: 0 20px 40px -10px var(--shadow-panel), 0 0 0 1px var(--shadow-sm);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transform: scale(var(--frame-scale-factor, 1));
      transform-origin: center center;
      transition: transform var(--motion-duration-slow) var(--motion-ease),
                  width var(--motion-duration-slow) var(--motion-ease),
                  height var(--motion-duration-slow) var(--motion-ease);
    }

    
    .viewport-scale-wrapper {
      width: calc(var(--frame-target-width, 100%) * var(--frame-scale-factor, 1));
      height: calc(var(--frame-target-height, 100%) * var(--frame-scale-factor, 1));
      max-width: 100%;
      max-height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: width var(--motion-duration-slow) var(--motion-ease),
                  height var(--motion-duration-slow) var(--motion-ease);
    }

    
    body.lab-booting .viewport-frame,
    body.lab-booting .viewport-scale-wrapper {
      transition: none;
    }

    
    .viewport-frame.orientation-vertical {
      border-color: var(--badge-success-border);
      box-shadow: 0 25px 50px -12px var(--shadow-panel), 0 0 20px var(--color-success-surface);
    }

    .viewport-frame.orientation-horizontal {
      border-color: var(--badge-info-border);
      box-shadow: 0 25px 50px -12px var(--shadow-panel), 0 0 25px var(--badge-info-bg);
    }

    .viewport-frame-bar {
      height: 36px;
      background: var(--panel-deep-strong);
      border-bottom: 1px solid var(--border-subtle);
      padding: 0 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      user-select: none;
    }

    .frame-controls-dots {
      display: flex;
      gap: 6px;
      align-items: center;
    }

    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
    }
    .dot-red { background: var(--color-danger); }
    .dot-yellow { background: var(--color-warning); }
    .dot-green { background: var(--color-success); }

    .frame-dimension-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--badge-info-text);
      background: var(--badge-info-bg);
      padding: 0.15rem 0.5rem;
      border-radius: 9999px;
      border: 1px solid var(--badge-info-border);
    }

    .viewport-iframe-wrapper {
      flex: 1;
      min-height: 0;
      width: 100%;
      height: 100%;
      position: relative;
      background: var(--color-bg);
    }

    .viewport-iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }

    
    .cors-alert-toast {
      background: var(--badge-danger-bg);
      border: 1px solid var(--badge-danger-border);
      border-radius: 8px;
      padding: 0.6rem 1rem;
      margin-bottom: 0.75rem;
      color: var(--panel-danger-text);
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      width: 100%;
      max-width: 900px;
    }

    
    .lab-footer {
      height: 38px;
      background: var(--panel-deep-strong);
      border-top: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      font-size: 0.75rem;
      color: var(--color-text-secondary);
      flex-shrink: 0;
    }

    .footer-status-pill {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--badge-success-text);
    }
    
    .preset-chips-scroll {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      max-height: 12rem;
      overflow-y: auto;
    }

    .chip-custom-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      margin-left: 0.3rem;
      border-radius: 50%;
      background: var(--badge-accent-text);
      vertical-align: middle;
    }

    .device-manager-backdrop {
      position: fixed;
      inset: 0;
      z-index: 1200;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      background: var(--scrim-opaque);
      backdrop-filter: blur(var(--blur-surface, 8px));
    }

    .device-manager-backdrop.open {
      display: flex;
    }

    .device-manager-modal {
      width: 100%;
      max-width: 720px;
      max-height: 86vh;
      overflow-y: auto;
      background: var(--panel-strong);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg, 12px);
      box-shadow: var(--shadow-hover);
      color: var(--panel-text);
      padding: 1.25rem 1.5rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .dm-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 0.75rem;
    }

    .dm-header h2 {
      margin: 0;
      font-size: 1.05rem;
      color: var(--panel-text);
    }

    .dm-hint {
      margin: 0;
      font-size: 0.8rem;
      color: var(--panel-text-muted);
    }

    .dm-form {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr auto;
      gap: 0.5rem;
      align-items: end;
      padding: 0.85rem;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md, 8px);
      background: var(--overlay-faint);
    }

    .dm-field {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      font-size: 0.72rem;
      color: var(--panel-text-muted);
    }

    .dm-field input,
    .dm-field select {
      background: var(--panel-deep);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm, 4px);
      color: var(--panel-text);
      padding: 0.35rem 0.5rem;
      font-size: 0.8rem;
      font-family: inherit;
    }

    .dm-list {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .dm-row {
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: 0.6rem;
      align-items: center;
      padding: 0.5rem 0.65rem;
      border: 1px solid var(--border-faint);
      border-radius: var(--radius-sm, 4px);
      background: var(--overlay-faint);
      font-size: 0.8rem;
    }

    .dm-row-name {
      color: var(--panel-text);
    }

    .dm-row-dims {
      color: var(--panel-text-muted);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.74rem;
    }

    .dm-lock {
      font-size: 0.7rem;
      color: var(--panel-text-muted);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-pill, 9999px);
      padding: 0.1rem 0.5rem;
      white-space: nowrap;
    }

    .dm-delete {
      background: var(--badge-danger-bg);
      border: 1px solid var(--badge-danger-border);
      color: var(--badge-danger-text);
      border-radius: var(--radius-sm, 4px);
      padding: 0.2rem 0.5rem;
      cursor: pointer;
      font-size: 0.74rem;
    }

    .dm-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      border-top: 1px solid var(--border-subtle);
      padding-top: 0.75rem;
    }

    .dm-error {
      color: var(--panel-danger-text);
      font-size: 0.75rem;
      min-height: 1rem;
    }

    .lab-disclosure {
      width: 100%;
    }

    .lab-disclosure-summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.25rem 0.35rem;
      border-radius: 6px;
      border: 1px solid var(--border-subtle);
      background: var(--overlay-faint);
      user-select: none;
    }

    .lab-disclosure-summary::-webkit-details-marker {
      display: none;
    }

    .lab-disclosure-body {
      margin-top: 0.35rem;
      font-size: 0.72rem;
      line-height: 1.4;
      background: var(--overlay-faint);
      padding: 0.45rem;
      border-radius: 4px;
      border: 1px solid var(--border);
    }

    .mcard-result-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
      padding: 0.12rem 0;
      border-bottom: 1px solid var(--border-faint);
    }

    .mcard-result-row:last-child {
      border-bottom: none;
    }

    .mcard-result-key {
      color: var(--color-text-muted);
      font-weight: 600;
      flex-shrink: 0;
    }

    .mcard-result-val {
      color: var(--color-text-primary);
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      word-break: break-all;
      text-align: right;
    }

    .spa-workflow-card {
      background: var(--overlay-faint);
      border: 1px solid var(--border-subtle);
      border-radius: 8px;
      padding: 0.65rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      width: 100%;
    }

    .spa-workflow-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.4rem;
      flex-wrap: wrap;
    }

    .spa-workflow-title {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--color-text-primary);
      margin: 0;
    }

    .spa-workflow-deferred-badge {
      font-size: 0.62rem;
      padding: 0.12rem 0.45rem;
    }

    .spa-workflow-live-status {
      font-size: 0.68rem;
      color: var(--color-text-secondary);
      line-height: 1.35;
    }

    .spa-workflow-live-error {
      font-size: 0.7rem;
      color: var(--badge-danger-text);
      background: var(--badge-danger-bg);
      border: 1px solid var(--badge-danger-border);
      border-radius: 6px;
      padding: 0.35rem 0.5rem;
      line-height: 1.35;
    }

    .spa-workflow-warnings {
      font-size: 0.68rem;
      color: var(--color-text-primary);
      background: var(--overlay-soft);
      border: 1px solid var(--border-strong);
      border-radius: 6px;
      padding: 0.35rem 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .spa-workflow-warnings-title {
      font-weight: 600;
    }

    .spa-workflow-tablist {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    .spa-workflow-tab {
      background: var(--panel);
      border: 1px solid var(--border-strong);
      color: var(--color-text-secondary);
      border-radius: 5px;
      padding: 0.22rem 0.45rem;
      font-size: 0.68rem;
      font-weight: 600;
      cursor: pointer;
    }

    .spa-workflow-tab.active {
      background: var(--badge-info-bg);
      border-color: var(--color-primary);
      color: var(--badge-info-text);
    }

    .spa-workflow-panel {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding-top: 0.15rem;
    }

    .spa-workflow-panel[hidden] {
      display: none;
    }

    .spa-workflow-meta-grid {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      font-size: 0.7rem;
    }

    .spa-workflow-kv {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.4rem;
    }

    .spa-workflow-k {
      color: var(--color-text-muted);
      font-weight: 600;
      flex-shrink: 0;
    }

    .spa-workflow-v {
      color: var(--color-text-primary);
      text-align: right;
      word-break: break-word;
    }

    .spa-workflow-note {
      font-size: 0.68rem;
      color: var(--color-text-muted);
      line-height: 1.35;
      margin: 0;
    }

    .spa-workflow-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
    }

    .spa-workflow-table-wrap {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--border-subtle);
      border-radius: 6px;
    }

    .spa-workflow-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.66rem;
    }

    .spa-workflow-table th,
    .spa-workflow-table td {
      padding: 0.25rem 0.35rem;
      text-align: left;
      border-bottom: 1px solid var(--border-faint);
      vertical-align: top;
      white-space: nowrap;
    }

    .spa-workflow-table th {
      color: var(--color-text-muted);
      font-weight: 600;
      background: var(--panel-deep);
    }

    .spa-workflow-incomplete-banner {
      background: var(--badge-danger-bg);
      border: 1px solid var(--badge-danger-border);
      color: var(--badge-danger-text);
      border-radius: 6px;
      padding: 0.3rem 0.45rem;
      font-size: 0.68rem;
      font-weight: 600;
    }

    .spa-workflow-evidence-box {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      border-top: 1px solid var(--border-faint);
      padding-top: 0.3rem;
    }
  </style>
