{
  "name": "pkc-landing-page-monorepo",
  "version": "0.0.0",
  "description": "PKC Landing Page & Server - A Personal Knowledge Container web application and server",
  "main": "index.js",
  "bin": {
    "pkc-landing-page": "./bin/pkc-landing.js"
  },
  "files": [
    "public",
    "js",
    "server",
    "routes",
    "bin",
    "index.js",
    "ws-server.js",
    "room-*.mjs",
    "config.js",
    "app-config.json"
  ],
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "playwright test",
    "test:unit": "node --test 'tests/unit/**/*.test.*' 'tests/observability/**/*.test.*' tests/single-page-mcard.test.mjs",
    "check:playwright-discovery": "node scripts/check-playwright-discovery.mjs",
    "check:net": "node scripts/check-net.mjs",
    "test:responsive": "playwright test tests/features/systematic-landing-test.spec.js --project=features",
    "test:replay": "playwright test tests/features/responsive-replay.spec.js --project=features",
    "test:conformance": "playwright test tests/features/device-conformance.spec.js --project=features",
    "test:presentation": "playwright test tests/features/presentation-lattice.spec.js --project=features",
    "test:headed:slowmo": "SLOWMO=1000 playwright test tests/features/presentation-lattice.spec.js --project=features --headed",
    "test:smoke": "playwright test --project=smoke",
    "test:components": "playwright test --project=components",
    "test:features": "playwright test --project=features",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "install-browsers": "playwright install",
    "report": "playwright show-report",
    "ws-server": "node ws-server.js",
    "dev": "node -e \"import('node:child_process').then(({spawn})=>{const a=spawn(process.execPath,['ws-server.js'],{stdio:'inherit'});const b=spawn(process.execPath,['./node_modules/astro/bin/astro.mjs','dev','--port',process.env.ASTRO_PORT||'4322'],{stdio:'inherit'});let stopping=false;const stop=(code=0)=>{if(stopping)return;stopping=true;a.kill('SIGTERM');b.kill('SIGTERM');setTimeout(()=>process.exit(code),150).unref();};process.on('SIGINT',()=>stop(0));process.on('SIGTERM',()=>stop(0));a.on('exit',(c)=>stop(c??0));b.on('exit',(c)=>stop(c??0));})\"",
    "build:mcard": "node scripts/build-mcard-bundle.js",
    "build:charts": "node scripts/build-chart-bundles.js",
    "build": "npm run build:astro && npm run build:packages",
    "publish:all": "npm publish --workspaces",
    "version:major": "npm version major --workspaces",
    "version:minor": "npm version minor --workspaces",
    "version:patch": "npm version patch --workspaces",
    "test:smoke:cross-browser": "PW_CROSS_BROWSER=1 playwright test --project=smoke-firefox --project=smoke-webkit",
    "build:astro": "astro build",
    "build:packages": "(cd packages/core && node build.js) && (cd packages/markdown-renderer && node build.js)",
    "start": "node ws-server.js",
    "docs:gen-net": "node scripts/gen-net-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xlp0/LandingPage.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/xlp0/LandingPage/issues"
  },
  "homepage": "https://github.com/xlp0/LandingPage#readme",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.27.1"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/preact": "6.1.1",
    "@mlc-ai/web-llm": "^0.2.80",
    "@reduxjs/toolkit": "^1.9.7",
    "animejs": "^4.2.2",
    "astro": "7.4.2",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.5.0",
    "clm-kernel": "0.0.18",
    "cordis": "^4.0.0-rc.10",
    "core-js": "^3.46.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.25",
    "mathjax": "^4.0.0",
    "preact": "11.1.0",
    "redux": "^5.0.1",
    "serve-index": "^1.9.1",
    "three": "^0.182.0",
    "ws": "^8.18.3"
  }
}
